# Copy to .env and edit.

# LAN IP of the machine running this (what you type in your browser).
HOST_IP=192.168.1.50

# Other hostnames/IPs you'll open the page with, comma-separated
# (e.g. the machine's hostname or a Tailscale IP). Leave empty if none.
EXTRA_ALLOWED_HOSTS=

# How often to poll Amazon for thermostat state, in seconds.
POLL_SECONDS=60

# Your time zone (used to split HVAC runtime into days). e.g. America/Chicago
TZ=America/New_York

# Where the history database is written. Point this at a big disk if you like.
HISTORY_DIR=./history

# Grafana (History tab). Port and admin password (admin login is only for editing dashboards).
GRAFANA_PORT=3010
GRAFANA_ADMIN_PASSWORD=change-me

# 1 = log raw Amazon responses. These logs contain account/device identifiers.
DEBUG=0
